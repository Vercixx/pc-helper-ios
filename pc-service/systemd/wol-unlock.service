[Unit]
Description=Wake-on-LAN and logind session unlock service
Documentation=file:%h/.local/share/wol-unlock/PROTOCOL.md
# Ordering only, not a dependency: the service is useful before a graphical
# session exists (status, wake relay) and must keep running while one is locked.
After=graphical-session.target
# A crash loop from a bad config should give up rather than spin forever.
# These are [Unit] keys; systemd silently ignores them under [Service].
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/share/wol-unlock/venv/bin/wol-unlock
Restart=on-failure
RestartSec=5s
Environment=PYTHONUNBUFFERED=1
# The code chmods the key, the database and the socket to 0600 explicitly; this
# closes the window between creation and chmod, and covers anything added later.
UMask=0077

# --- Privilege ------------------------------------------------------------
# Nothing here needs elevation. logind grants UnlockSession without consulting
# polkit when the caller's uid matches the session's, which it does: this unit
# runs as the user who owns the desktop session. No sudo, no setuid, no polkit
# rule anywhere in this project.
NoNewPrivileges=yes

# --- Filesystem -----------------------------------------------------------
ProtectSystem=strict
ProtectHome=read-only
# State: the server key, the device table and the replay cache.
ReadWritePaths=%h/.local/share/wol-unlock
# $XDG_RUNTIME_DIR, where the 0600 control socket is bound. ProtectSystem=strict
# mounts the whole hierarchy read-only -- including /run -- so without this the
# service starts, opens its database, and then dies with EROFS on bind().
ReadWritePaths=%t
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProtectHostname=yes
ProtectClock=yes

# --- Process --------------------------------------------------------------
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=

# --- Network --------------------------------------------------------------
# AF_NETLINK is required: interface enumeration (both ours and python-zeroconf's
# via ifaddr) goes through it. AF_UNIX carries the control socket and D-Bus.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# NOTE: IPAddressDeny=/IPAddressAllow= are deliberately absent. They install a
# BPF cgroup filter, which requires root; in a --user unit systemd only logs
# "unit configures an IP firewall, but not running as root" and ignores them.
# Leaving them in would imply a kernel-level guarantee that is not actually in
# force. LAN-only is enforced in the service itself, by the peer-address check
# against http.allowed_networks that runs before any request is parsed.

[Install]
WantedBy=default.target
